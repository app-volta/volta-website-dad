# Base da API do VOLTA, sempre relativa: o navegador chama /api e o proxy
# (Vite no desenvolvimento, rewrite no vercel.json em produção) repassa à volta-api.
VITE_API_BASE_URL=/api

# Base do chatbot (assistente VOLTA), também por proxy: /chat-api.
VITE_CHAT_API_BASE_URL=/chat-api

# Base da API de ranking (volta-api-redis), também por proxy: /ranking-api.
VITE_RANKING_API_BASE_URL=/ranking-api

# Mocks ficam ligados por padrão. Troque para false para usar a volta-api de verdade.
VITE_USAR_MOCKS=true

# Destino do proxy do Vite (só desenvolvimento). Padrão: a API de QA.
# VITE_API_PROXY_TARGET=https://api.qa.54.210.1.34.sslip.io
# VITE_CHAT_PROXY_TARGET=https://chat.qa.54.210.1.34.sslip.io
# VITE_RANKING_PROXY_TARGET=https://ranking.qa.54.210.1.34.sslip.io

# Chave (opcional) do serviço de classificação por IA.
# Enquanto o backend real não existe, o app usa o mock em src/services/classificacao.ts.
VITE_CLASSIFICACAO_API_KEY=

# Fotos das ocorrências: o navegador envia a foto ao Cloudinary (sem chave, por uma
# configuração de envio criada na conta) e a volta-api guarda só o endereço.
# Nenhum dos dois valores é segredo. Sem eles a ocorrência é registrada sem foto.
VITE_CLOUDINARY_CLOUD_NAME=kgou1air
VITE_CLOUDINARY_PRESET_OCORRENCIA=AI-Analysis
# VITE_CLOUDINARY_API_URL=https://api.cloudinary.com/v1_1
