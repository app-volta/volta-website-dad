# Base URL da API do VOLTA. Em ambiente local, use um proxy ou um mock.
VITE_API_BASE_URL=https://api.volta.example.com

# Chave (opcional) do serviço de classificação por IA.
# Enquanto o backend real não existe, o app usa o mock em src/services/classificacao.ts.
VITE_CLASSIFICACAO_API_KEY=

# Habilita mocks locais mesmo quando a API estiver configurada.
VITE_USAR_MOCKS=true
